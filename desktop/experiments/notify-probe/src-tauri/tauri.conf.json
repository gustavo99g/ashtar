{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ashtar Notify Probe",
	"version": "0.0.1",
	"identifier": "com.gustavo99g.ashtar.notifyprobe",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Ashtar Notify Probe",
				"width": 760,
				"height": 720,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
