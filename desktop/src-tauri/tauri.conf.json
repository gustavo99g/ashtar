{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ashtar",
	"version": "../package.json",
	"identifier": "com.gustavo99g.ashtar",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Ashtar",
				"width": 1440,
				"height": 900,
				"minWidth": 1000,
				"minHeight": 640,
				"center": true,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQTQ4NjMyNUE5QzgyMEMKUldRTWdweGFNb2Frb0l1T1QyYlNZSHpLQytldmtxdW1CenlsekMzOUR3Z1BmU3NLaFR0MnhCaG4K",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
