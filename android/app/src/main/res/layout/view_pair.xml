<?xml version="1.0" encoding="utf-8"?>
<!-- Sem pareamento: o servidor (Internet ou Local, que acha a API no Wi-Fi) e o código. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pair_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/pair_title"
        android:textColor="@color/foreground"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pair_help"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_server" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segment_group"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/mode_internet"
                style="@style/Segment"
                android:text="@string/mode_internet" />

            <RadioButton
                android:id="@+id/mode_local"
                style="@style/Segment"
                android:text="@string/mode_local" />
        </RadioGroup>

        <EditText
            android:id="@+id/server_input"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/server_hint"
            android:inputType="textUri" />

        <LinearLayout
            android:id="@+id/local_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp">

                    <ProgressBar
                        android:id="@+id/local_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/local_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/muted" />
                </FrameLayout>

                <TextView
                    android:id="@+id/local_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/local_search"
                    style="@style/OutlineButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/local_search" />
            </LinearLayout>

            <EditText
                android:id="@+id/local_input"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/local_hint"
                android:inputType="textUri" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_code" />

        <EditText
            android:id="@+id/code_input"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:hint="@string/code_hint"
            android:inputType="number"
            android:letterSpacing="0.4"
            android:maxLength="6"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/code_help"
            android:textColor="@color/subtle"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/pair_button"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/pair"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/pair_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:textColor="@color/error"
        android:textSize="13sp" />
</LinearLayout>
