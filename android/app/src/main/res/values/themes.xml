<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Transmissor" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorHighlight">@color/primary_soft</item>
    </style>

    <!-- O "Transmitir agora" (o bloco das Configurações rápidas): só a confirmação do Android aparece. -->
    <style name="Theme.Transmissor.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/subtle</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorHint">@color/subtle</item>
        <item name="android:textSize">15sp</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GhostButton">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="OutlineButton" parent="GhostButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
    </style>
</resources>
