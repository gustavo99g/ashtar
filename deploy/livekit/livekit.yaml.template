# Gerado pelo setup.sh a partir de livekit.yaml.template. Contém o segredo: não vai para o git.
port: 7880
bind_addresses:
  - 127.0.0.1 # o sinal só é alcançado pelo Caddy

rtc:
  # Fallback por TCP para quem não consegue UDP.
  tcp_port: 7881
  # Toda a mídia UDP numa porta só (mux), em vez da faixa 50000-60000.
  udp_port: 7882
  use_external_ip: true

# TURN embutido só por UDP: ajuda quem está atrás de NAT restritivo.
# O TURN/TLS na 443 (para redes que só deixam HTTPS) fica para a v0.2.4.
turn:
  enabled: true
  domain: __LIVEKIT_DOMAIN__
  udp_port: 3478
  tls_port: 0

keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__

room:
  # Sala sem ninguém fecha depois de 5 minutos.
  empty_timeout: 300

logging:
  level: info
