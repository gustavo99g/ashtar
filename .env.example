LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# A API que o app chama (o frontend e o login do Rust); embutida no app no build.
VITE_API_URL=http://127.0.0.1:3000

# Desligados quando vazios. Só ligar depois que todos estiverem na 0.2.0 (docs/plans/v0.2.0-notes.md).
MIN_CLIENT_VERSION=
# Arquivo do banco, relativo à pasta onde a API roda (api/).
DATABASE_URL=sqlite://ashtar.db
# Endereço público da API, sem barra final: monta o link dos convites (/invite/CÓDIGO).
# No computador de casa, a URL do Funnel (https://<máquina>.<rede>.ts.net).
PUBLIC_URL=http://127.0.0.1:3000
# Onde a API escuta. Vazio: 127.0.0.1:3000, só neste computador. Para o Transmissor do Odin achar a
# API pelo Wi-Fi (o modo Local), 0.0.0.0:3000; libere a porta no firewall.
BIND_ADDR=
# Quantas pessoas transmitem a tela ao mesmo tempo numa sala (ADR 0024). Vazio: 6.
MAX_SHARES_PER_ROOM=
